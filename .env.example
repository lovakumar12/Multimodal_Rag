# ==============================================================================
# MULTIMODAL RAG PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here

# Models Selection
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.5-flash-lite
AUTO_DESCRIBE_IMAGES=True

# Database (Leave default for local SQLite or configure PostgreSQL)
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///data/multimodal_rag.db
# Docker / Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/multimodal_rag

# Vector Storage Configuration
VECTOR_STORE_TYPE=faiss
VECTOR_DIMENSION=384

# Image Relevance Scoring Weights
WEIGHT_DESC_SIM=0.35
WEIGHT_TEXT_SIM=0.25
WEIGHT_CAPTION_SIM=0.20
WEIGHT_PAGE_SIM=0.10
WEIGHT_CO_OCCURRENCE=0.10
IMAGE_RELEVANCE_THRESHOLD=0.40
MAX_RETURNED_VISUALS=3

# Object Storage (Local by default, or S3)
STORAGE_BACKEND=local
# OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
# OBJECT_STORAGE_BUCKET=multimodal-rag-bucket
# OBJECT_STORAGE_ACCESS_KEY=your_access_key
# OBJECT_STORAGE_SECRET_KEY=your_secret_key

# Redis Queue
# REDIS_URL=redis://localhost:6379/0
